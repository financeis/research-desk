# === Telegram API ===
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 대상 채널
#  - public 채널: TELEGRAM_CHANNEL=<채널 username>
#  - private 채널: TELEGRAM_CHANNEL_ID=<int>  +  TELEGRAM_CHANNEL=<라벨>
#    (라벨은 DB의 chat_username 컬럼에 저장됨. 기존 데이터와 같은 값을
#     유지하면 옛 데이터와의 연속성이 유지됨.)
TELEGRAM_CHANNEL=
# TELEGRAM_CHANNEL_ID=<숫자 채널 ID>

# === Supabase ===
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=

# === 선택: 기본값 사용하려면 비워두면 됨 ===
# TELEGRAM_SESSION_NAME=samstudy
# STORAGE_BASE_DIR=./reports
# INITIAL_CUTOFF_DAYS=30
# MAX_CONCURRENT_DOWNLOADS=4   # 동시 다운로드 수. 백필 시 8 권장. FloodWait 자주 뜨면 줄이세요.
# LOG_LEVEL=INFO

# === tagger (python -m research_desk tag) ===
# 모델 이름이 provider를 정함: claude-* → ANTHROPIC_API_KEY, 그 외(gpt-*) → OPENAI_API_KEY.
# 쓰는 provider의 키만 있으면 됨. (구 이름 OPENAI_MODEL_* 도 계속 인식)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_MODEL_DEFAULT=claude-haiku-5-5
LLM_MODEL_ESCALATION=gpt-5.4
# Claude 사고 깊이: low | medium(기본) | high | xhigh | max
# ANTHROPIC_EFFORT=medium
MAX_CONCURRENT_LLM=2
TAGGER_BATCH_SIZE_DEFAULT=10
KRX_CSV_PATH=docs/stock_data/KRX_stocks_data.csv
# Direct Postgres connection string for Supabase. Required by every tag command
# (atomic claim / stale-lock reclaim / writes via asyncpg). Get it from
# Supabase project settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres:<pw>@<host>:5432/postgres

# Concurrency / lock safety knobs (rules: docs/business-rules.md, 분류 상태 전이)
# LOCK_TTL_MINUTES * 60 must be longer than one batch can take:
# ceil(TAGGER_BATCH_SIZE_DEFAULT / MAX_CONCURRENT_LLM) * PER_ROW_DEADLINE_S
# (defaults: 5 * 90 s = 7.5 min). A batch locks all its rows when it claims
# them, so a shorter TTL lets another run reclaim rows still waiting their turn.
LOCK_TTL_MINUTES=30
PER_ROW_DEADLINE_S=90

# === LangSmith (선택 — LangGraph 자동 trace) ===
# LangGraph 1.0+은 LANGSMITH_TRACING=true + LANGSMITH_API_KEY가 설정되어 있으면
# 모든 그래프 실행을 LangSmith로 자동 송출함. 코드 변경 불필요.
# https://smith.langchain.com 에서 API key 발급. 무료 tier 5,000 trace/월.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langgraph-tagger     # 옵션 (없으면 'default' 프로젝트로 들어감)
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com    # 옵션 (기본값)

# === report analysis / compare (Research Desk web) ===
# Research Desk에서 리포트 분석·비교 버튼을 눌렀을 때만 호출. 미설정 시 default 사용.
# codex:<model> → 로컬 Codex CLI(`codex exec`, ChatGPT 로그인 계정 한도 사용, API 키 불필요).
# 리포트를 사용자가 골라 분석할 때만 호출됨. API로 돌리려면 gpt-6-luna.
LLM_MODEL_PHASE2=codex:gpt-6-luna
# CODEX_REASONING_EFFORT=high   # medium은 빠르지만 재무 지표가 ~40% 적게 나옴
PHASE2_PER_REPORT_TIMEOUT_S=180   # 재무 추출 프롬프트가 지표를 최대 48개까지 뽑아 gpt-6-luna 기준 최대 ~105초
PHASE2_IMAGE_TIMEOUT_S=360   # 본문 글자가 사실상 없는 PDF를 쪽 그림으로 분석할 때의 호출 한도(넘으면 다시 시도하지 않음)
PHASE2_MAX_INPUT_TOKENS=30000
PHASE2_SUMMARY_VERSION=llm-summary@1.0

# === 주가 (python -m research_desk prices update) ===
# 평일 장 마감 뒤 작업 스케줄러가 scripts\run-prices.ps1로 실행. 웹앱 상태 줄(자료 기준일)이 마지막 실행 결과를 보여 줌.
# 한국투자증권(KIS) Open API 실전 계정 앱키·시크릿. 둘 다 있어야 실행됨(없으면 종료 코드 4).
# masterdb 프로젝트와 같은 키라서 두 쪽의 KIS 수집을 같은 시간에 돌리지 않는다.
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_BASE_URL=https://openapi.koreainvestment.com:9443   # 기본: 실전 서비스 주소
# PRICES_MAX_CALLS_PER_SEC=10   # KIS 초당 호출 상한(0보다 큰 수). 빈 값으로 두면 오류

# === 수급 (python -m research_desk flows update, 웹앱의 수급 랭킹·수급 탭) ===
# scripts\run-prices.ps1이 주가 갱신이 성공(종료 코드 0)했을 때만 이어서 실행. KIS 키·주소·토큰 파일은 위 주가와 같은 값을 씀.
# FLOWS_MAX_CALLS_PER_SEC=10   # KIS 초당 호출 상한(0보다 큰 수). 빈 값으로 두면 오류

# === 유사 기업 (python -m research_desk peers build / peers inspect, 웹앱의 유사 기업·테마 검색) ===
# 사업보고서로 회사마다 AI 사업 요약 카드(프로필)를 만들고 임베딩해 비슷한 회사를 찾음. build는 연 1회.
# 프로필 모델: 모델 이름이 provider를 정함(claude-* → ANTHROPIC_API_KEY, codex:* → 로컬 codex CLI, 그 외 → OPENAI_API_KEY).
# 근거율이 0.8 미만이면 ESCALATION 모델로 한 번 더 추출. 기본값은 2026-10-10 시험 실행 뒤 정한 값.
# (구 이름 OPENAI_MODEL_PEERS / OPENAI_MODEL_PEERS_ESCALATION 도 인식)
# LLM_MODEL_PEERS=claude-sonnet-5-5
# LLM_MODEL_PEERS_ESCALATION=gpt-5.4
# 임베딩은 OpenAI라 위의 OPENAI_API_KEY가 필요(peers build, 웹 테마 검색). 1536차원으로 씀.
# PEERS_EMBED_MODEL=text-embedding-3-large
# PEERS_PROFILE_VERSION=peer-profile@1.2   # 바꾸면 다음 build가 프로필을 모두 새로 만듦(AI 비용)
# PEERS_FISCAL_YEAR=2025                   # build의 기본 회계연도(--fiscal-year로 바꿀 수 있음)
# PEERS_MAX_CONCURRENT_LLM=2               # build 중 AI 동시 호출. 운영 천장 2(태깅과 같은 이유: 분당 토큰 한도)
# PEERS_PER_COMPANY_TIMEOUT_S=120          # 회사 하나 추출 시간 한도(초, 재추출 포함)
# 사업보고서 텍스트가 든 MongoDB(DART 수집 프로그램이 채움)
# DART_MONGO_URL=mongodb://localhost:27017/
# DART_MONGO_DB=FS
# DART_MONGO_COLLECTION=A001_v2
